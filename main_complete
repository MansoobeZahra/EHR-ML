    "import os, gc\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "EICU_DIR = Path('/kaggle/input/datasets/mansoobezehra/eicu-dir/eicu-collaborative-research-database-2.0')\n",
    "\n",
    "# ── Smart loader: handles both direct files AND nested folder/file.csv ────────\n",
    "def load_eicu(fname, **kw):\n",
    "    \"\"\"Try direct path first, then nested path (Kaggle large-file quirk).\"\"\"\n",
    "    candidates = [\n",
    "        EICU_DIR / fname,                    # direct: diagnosis.csv\n",
    "        EICU_DIR / fname / fname,            # nested: vitalPeriodic.csv/vitalPeriodic.csv\n",
    "        EICU_DIR / (fname + '.gz'),\n",
    "        EICU_DIR / fname / (fname + '.gz'),\n",
    "    ]\n",
    "    for fp in candidates:\n",
    "        if fp.exists() and fp.is_file():\n",
    "            print(f'    Loading: {fp}')\n",
    "            return pd.read_csv(fp, low_memory=False, **kw)\n",
    "    raise FileNotFoundError(f'Could not find: {fname} in {EICU_DIR}')\n",
    "\n",
    "# ── Build eICU Sepsis cohort ──────────────────────────────────────────────────\n",
    "print('Building eICU Sepsis cohort...')\n",
    "eicu_diag = load_eicu('diagnosis.csv', usecols=['patientunitstayid','icd9code']).dropna()\n",
    "eicu_pat  = load_eicu('patient.csv',   usecols=['patientunitstayid','uniquepid','age',\n",
    "                                                  'unitdischargeoffset','hospitaldischargestatus'])\n",
    "\n",
    "def clean_age(a):\n",
    "    if pd.isna(a) or str(a).strip() == '': return 0\n",
    "    s = str(a).strip()\n",
    "    if s.startswith('>'): return 90\n",
    "    try: return float(s)\n",
    "    except: return 0\n",
    "\n",
    "eicu_pat['age_num'] = eicu_pat['age'].apply(clean_age)\n",
    "eicu_pat_adults = eicu_pat[eicu_pat['age_num'] >= 18]\n",
    "\n",
    "sepsis_codes = {'995.91', '995.92', '785.52'}\n",
    "def has_sepsis(val):\n",
    "    return any(c.strip() in sepsis_codes for c in str(val).split(','))\n",
    "\n",
    "eicu_diag_sepsis = eicu_diag[eicu_diag['icd9code'].apply(has_sepsis)]\n",
    "eicu_cohort = eicu_diag_sepsis.merge(eicu_pat_adults, on='patientunitstayid', how='inner')\n",
    "eicu_cohort = eicu_cohort.drop_duplicates(subset=['patientunitstayid'])\n",
    "print(f'  eICU Sepsis cohort: {eicu_cohort.shape[0]} episodes')\n",
    "eicu_stay_ids = set(eicu_cohort['patientunitstayid'])\n",
    "\n",
    "EICU_VITAL_COLS = {\n",
    "    'temperature':'temperature_f', 'sao2':'spo2', 'heartrate':'heart_rate',\n",
    "    'respiration':'resp_rate', 'systemicsystolic':'sbp',\n",
    "    'systemicdiastolic':'dbp', 'systemicmean':'mbp'\n",
    "}\n",
    "EICU_LAB_NAMES = {\n",
    "    'Hct':'hematocrit','Hgb':'hemoglobin','platelets x 1000':'platelet',\n",
    "    'WBC x 1000':'wbc','creatinine':'creatinine','potassium':'potassium',\n",
    "    'sodium':'sodium','calcium':'calcium','bicarbonate':'bicarbonate',\n",
    "    'lactate':'lactate','anion gap':'anion_gap','BUN':'bun',\n",
    "    'glucose':'glucose','magnesium':'magnesium','phosphate':'phosphate',\n",
    "    'PT - INR':'inr','PTT':'ptt','ALT (SGPT)':'alt','AST (SGOT)':'ast',\n",
    "    'total bilirubin':'bilirubin_total','pH':'ph','paCO2':'pco2','paO2':'po2'\n",
    "}\n",
    "\n",
    "# ── Load vitalPeriodic (nested path) ─────────────────────────────────────────\n",
    "print('  Processing vitalPeriodic...')\n",
    "vital_usecols = ['patientunitstayid','observationoffset'] + list(EICU_VITAL_COLS.keys())\n",
    "vp_path = EICU_DIR / 'vitalPeriodic.csv' / 'vitalPeriodic.csv'  # nested!\n",
    "v_chunks = []\n",
    "for chunk in pd.read_csv(vp_path, usecols=vital_usecols, chunksize=500000, low_memory=False):\n",
    "    f = chunk[chunk['patientunitstayid'].isin(eicu_stay_ids) &\n",
    "              (chunk['observationoffset'] >= 0) &\n",
    "              (chunk['observationoffset'] <= 4320)]\n",
    "    if not f.empty: v_chunks.append(f)\n",
    "eicu_v = pd.concat(v_chunks, ignore_index=True) if v_chunks else pd.DataFrame()\n",
    "del v_chunks; gc.collect()\n",
    "if not eicu_v.empty and 'temperature' in eicu_v.columns:\n",
    "    eicu_v['temperature'] = eicu_v['temperature'] * 9/5 + 32\n",
    "if not eicu_v.empty:\n",
    "    eicu_v = eicu_v.rename(columns=EICU_VITAL_COLS)\n",
    "print(f'    vitals shape: {eicu_v.shape}')\n",
    "\n",
    "# ── Load lab (find correct path) ──────────────────────────────────────────────\n",
    "print('  Processing lab...')\n",
    "# Check both possible paths\n",
    "lab_path = EICU_DIR / 'lab.csv' / 'lab.csv'\n",
    "if not lab_path.exists(): lab_path = EICU_DIR / 'lab.csv'\n",
    "print(f'    lab path: {lab_path}  exists={lab_path.exists()}')\n",
    "l_chunks = []\n",
    "for chunk in pd.read_csv(lab_path, usecols=['patientunitstayid','labresultoffset','labname','labresult'],\n",
    "                         chunksize=500000, low_memory=False):\n",
    "    f = chunk[chunk['patientunitstayid'].isin(eicu_stay_ids) &\n",
    "              chunk['labname'].isin(EICU_LAB_NAMES.keys()) &\n",
    "              (chunk['labresultoffset'] >= 0) &\n",
    "              (chunk['labresultoffset'] <= 4320)]\n",
    "    if not f.empty: l_chunks.append(f)\n",
    "eicu_l = pd.concat(l_chunks, ignore_index=True) if l_chunks else pd.DataFrame()\n",
    "del l_chunks; gc.collect()\n",
    "if not eicu_l.empty:\n",
    "    eicu_l['feature'] = eicu_l['labname'].map(EICU_LAB_NAMES)\n",
    "    eicu_l = eicu_l.dropna(subset=['feature'])\n",
    "print(f'    labs shape: {eicu_l.shape}')\n",
    "\n",
    "# ── Aggregate features ────────────────────────────────────────────────────────\n",
    "print('  Aggregating features...')\n",
    "def agg_wide_eicu(df, id_col, time_col, feat_col, val_col, prefix):\n",
    "    parts = []\n",
    "    df_s = df.sort_values([id_col, time_col])\n",
    "    for agg_name, fn in [('avg','mean'),('min','min'),('max','max'),('first','first'),('last','last')]:\n",
    "        g = (df_s if agg_name in ('first','last') else df).groupby([id_col, feat_col])[val_col].agg(fn).reset_index()\n",
    "        piv = g.pivot_table(index=id_col, columns=feat_col, values=val_col).reset_index()\n",
    "        piv.columns = [id_col] + [f'{prefix}_{c}_{agg_name}' for c in piv.columns if c != id_col]\n",
    "        parts.append(piv)\n",
    "    result = parts[0]\n",
    "    for p in parts[1:]: result = result.merge(p, on=id_col, how='outer')\n",
    "    return result\n",
    "\n",
    "eicu_wide_v = pd.DataFrame()\n",
    "if not eicu_v.empty:\n",
    "    v_long = eicu_v.melt(id_vars=['patientunitstayid','observationoffset'],\n",
    "                         value_vars=[c for c in eicu_v.columns if c not in ['patientunitstayid','observationoffset']],\n",
    "                         var_name='feature', value_name='valuenum').dropna()\n",
    "    eicu_wide_v = agg_wide_eicu(v_long, 'patientunitstayid', 'observationoffset', 'feature', 'valuenum', 'vitals')\n",
    "del eicu_v; gc.collect()\n",
    "\n",
    "eicu_wide_l = pd.DataFrame()\n",
    "if not eicu_l.empty:\n",
    "    eicu_wide_l = agg_wide_eicu(eicu_l, 'patientunitstayid', 'labresultoffset', 'feature', 'labresult', 'labs')\n",
    "del eicu_l; gc.collect()\n",
    "\n",
    "# ── Build final data matrix ───────────────────────────────────────────────────\n",
    "eicu_cohort['mortality'] = (eicu_cohort['hospitaldischargestatus'] == 'Expired').astype(int)\n",
    "eicu_cohort['los']       = eicu_cohort['unitdischargeoffset'] / 1440.0\n",
    "eicu_cohort['los_gt7']   = (eicu_cohort['los'] > 7).astype(int)\n",
    "eicu_cohort['los_gt14']  = (eicu_cohort['los'] > 14).astype(int)\n",
    "eicu_cohort['cohort']    = 'eICU'\n",
    "eicu_cohort['anchor_date'] = '2000-01-01'\n",
    "\n",
    "META_COLS  = ['subject_id','hadm_id','anchor_date','mortality','los_gt7','los_gt14','cohort']\n",
    "eicu_meta  = ['patientunitstayid','uniquepid','anchor_date','mortality','los_gt7','los_gt14','cohort']\n",
    "dm_eicu = eicu_cohort[eicu_meta].copy()\n",
    "if not eicu_wide_v.empty: dm_eicu = dm_eicu.merge(eicu_wide_v, on='patientunitstayid', how='left')\n",
    "if not eicu_wide_l.empty: dm_eicu = dm_eicu.merge(eicu_wide_l, on='patientunitstayid', how='left')\n",
    "dm_eicu = dm_eicu.rename(columns={'patientunitstayid':'hadm_id', 'uniquepid':'subject_id'})\n",
    "\n",
    "eicu_feat_cols = [c for c in dm_eicu.columns if c not in META_COLS]\n",
    "eicu_cov  = dm_eicu[eicu_feat_cols].notna().mean()\n",
    "eicu_keep = eicu_cov[eicu_cov >= 0.80].index.tolist()\n",
    "dm_eicu   = dm_eicu[META_COLS + eicu_keep].dropna(subset=eicu_keep, how='all')\n",
    "print(f'  eICU data matrix: {dm_eicu.shape}')\n",
    "dm_eicu.to_csv(OUT_DIR / 'data_matrix_eicu.csv', index=False)\n",
    "print('  ✅ eICU data matrix saved!')\n",
    "\n",
    "# ── Run EHR-ML + Figure 5 ─────────────────────────────────────────────────────\n",
    "print('\\nRunning EHR-ML on eICU cohort...')\n",
    "eicu_mort = run_ehrml(dm_eicu, target_col='mortality', tag='[eICU]')\n",
    "\n",
    "common = [c for c in dm_icd.columns if c in dm_eicu.columns and c not in META_COLS]\n",
    "print(f'Common features for cross-cohort: {len(common)}')\n",
    "\n",
    "def cross_auroc(dm_train, dm_test, target='mortality'):\n",
    "    X_tr = impute(dm_train[common]).values; y_tr = dm_train[target].values\n",
    "    X_te = impute(dm_test[common]).values;  y_te = dm_test[target].values\n",
    "    try:\n",
    "        m = XGBClassifier(eval_metric='logloss', verbosity=0, n_estimators=100)\n",
    "        m.fit(X_tr, y_tr)\n",
    "        return roc_auc_score(y_te, m.predict_proba(X_te)[:,1])\n",
    "    except Exception as e:\n",
    "        print(f'cross_auroc error: {e}'); return np.nan\n",
    "\n",
    "icd2eicu = cross_auroc(dm_icd,  dm_eicu)\n",
    "eicu2icd = cross_auroc(dm_eicu, dm_icd)\n",
    "icd_auc  = icd_mort['cv_scores']['test_roc_auc'].mean()\n",
    "eicu_auc = eicu_mort['cv_scores']['test_roc_auc'].mean()\n",
    "\n",
    "hm  = np.array([[icd_auc, icd2eicu],[eicu2icd, eicu_auc]])\n",
    "lbs = ['MIMIC-IV Cohort','eICU Cohort']\n",
    "print(f'\\nMIMIC->MIMIC={icd_auc:.3f}  eICU->eICU={eicu_auc:.3f}  MIMIC->eICU={icd2eicu:.3f}  eICU->MIMIC={eicu2icd:.3f}')\n",
    "print(f'Paper:  MIMIC->MIMIC=0.85   eICU->eICU=0.89   MIMIC->eICU=0.84   eICU->MIMIC=0.83')\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(5,4))\n",
    "im = ax.imshow(hm, cmap='Blues', vmin=0.5, vmax=1.0, aspect='auto')\n",
    "plt.colorbar(im, ax=ax, label='AUROC')\n",
    "ax.set_xticks([0,1]); ax.set_xticklabels(lbs)\n",
    "ax.set_yticks([0,1]); ax.set_yticklabels(lbs)\n",
    "ax.set_xlabel('Validation Set'); ax.set_ylabel('Training Set')\n",
    "ax.set_title('Figure 5: Inter-Cohort Validation Heatmap', fontweight='bold')\n",
    "for i in range(2):\n",
    "    for j in range(2):\n",
    "        v = hm[i,j]\n",
    "        ax.text(j, i, f'{v:.3f}' if not np.isnan(v) else 'N/A',\n",
    "                ha='center', va='center', fontsize=13, fontweight='bold',\n",
    "                color='white' if v > 0.75 else 'black')\n",
    "plt.tight_layout()\n",
    "plt.savefig(OUT_DIR / 'fig5_intercohort.png', bbox_inches='tight', dpi=150)\n",
    "plt.show()\n",
    "print('✅ Figure 5 saved!')"
