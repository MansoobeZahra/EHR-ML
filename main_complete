ning applications with electronic health records.\nInt. J. Medical Informatics, 196, 105816.\nhttps://doi.org/10.1016/j.ijmedinf.2025.105816\n```","metadata":{"papermill":{"duration":0.02451,"end_time":"2026-06-23T09:20:01.032704+00:00","exception":false,"start_time":"2026-06-23T09:20:01.008194+00:00","status":"completed"},"tags":[]}},{"id":"99e7f38e","cell_type":"code","source":"from pathlib import Path\n\nROOT = Path(\"/kaggle/input/datasets\")\n\nprint(\"Folders inside /kaggle/input/datasets:\")\nfor p in ROOT.iterdir():\n    print(\" \", p)\n\nprint(\"\\nSearching for eICU files recursively:\")\nfor name in [\"patient.csv\", \"diagnosis.csv\", \"vitalPeriodic.csv\", \"lab.csv\"]:\n    hits = list(ROOT.rglob(name)) + list(ROOT.rglob(name + \".gz\"))\n    print(name, \"=>\")\n    for h in hits[:10]:\n        print(\"   \", h)","metadata":{"execution":{"iopub.execute_input":"2026-06-23T09:20:01.083973Z","iopub.status.busy":"2026-06-23T09:20:01.083605Z","iopub.status.idle":"2026-06-23T09:20:01.440124Z","shell.execute_reply":"2026-06-23T09:20:01.438976Z"},"papermill":{"duration":0.384227,"end_time":"2026-06-23T09:20:01.441929+00:00","exception":false,"start_time":"2026-06-23T09:20:01.057702+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Folders inside /kaggle/input/datasets:\n","  /kaggle/input/datasets/mansoobezehra\n","\n","Searching for eICU files recursively:\n","patient.csv =>\n","    /kaggle/input/datasets/mansoobezehra/eicu-dir/eicu-collaborative-research-database-2.0/patient.csv\n","diagnosis.csv =>\n","    /kaggle/input/datasets/mansoobezehra/eicu-dir/eicu-collaborative-research-database-2.0/diagnosis.csv\n","vitalPeriodic.csv =>\n","    /kaggle/input/datasets/mansoobezehra/eicu-dir/eicu-collaborative-research-database-2.0/vitalPeriodic.csv\n","    /kaggle/input/datasets/mansoobezehra/eicu-dir/eicu-collaborative-research-database-2.0/vitalPeriodic.csv/vitalPeriodic.csv\n","lab.csv =>\n","    /kaggle/input/