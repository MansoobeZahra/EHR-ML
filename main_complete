 if already computed\n# ============================================================\n\nfrom sklearn.impute import SimpleImputer\nfrom sklearn.metrics import roc_auc_score\nfrom xgboost import XGBClassifier\nimport numpy as np\nimport pandas as pd\nimport matplotlib.pyplot as plt\nimport os\n\neicu_path = OUT_DIR / \"data_matrix_eicu.csv\"\n\nif not os.path.exists(eicu_path):\n    raise FileNotFoundError(\n        \"data_matrix_eicu.csv not found. Run the eICU build cell before Figure 5.\"\n    )\n\ndm_eicu = pd.read_csv(eicu_path)\n\n# Only run EHR-ML on eICU if not already run\nif \"eicu_mort\" not in globals():\n    print(\"Running EHR-ML on eICU cohort...\")\n    eicu_mort = run_ehrml(\n        dm_eicu,\n        target_col=\"mortality\",\n        tag=\"[eICU ICD]\"\n    )\nelse:\n    print(\"Using existing eicu_mort result.\")\n\ndef get_auc_from_result(res):\n    if isinstance(res, dict):\n        if \"roc_auc_mean\" in res:\n            return res[\"roc_auc_mean\"]\n        if \"cv_scores\" in res and \"test_roc_auc\" in res[\"cv_scores\"]:\n            return res[\"cv_scores\"][\"test_roc_auc\"].mean()\n    return np.nan\n\ndef cross_auroc(dm_train, dm_test, target=\"mortality\"):\n    exclude = set(META_COLS) | {\"age\", \"gender\", \"los\"}\n\n    common = [\n        c for c in dm_train.columns\n        if c in dm_test.columns and c not in exclude\n    ]\n\n    print(\"Common features:\", len(common))\n    print(\"First common features:\", common[:20])\n\n    if len(common) == 0:\n        return np.nan\n\n    X_tr_raw = dm_train[common]\n    X_te_raw = dm_test[common]\n\n    y_tr = dm_train[target].values\n    y_te = dm_test[target].values\n\n    imp = SimpleImputer(strategy=\"median\")\n    X_tr = imp.fit_transform(X_tr_raw)\n    X_te = imp.transform(X_te_raw)\n\n    model = XGBClassifier(\n        eval_metric=\"logloss\",\n        verbosity=0,\n        n_estimators=100,\n        max_depth=3,\n        learning_rate=0.05,\n        subsample=0.9,\n        colsample_bytree=0.9,\n        random_state=42,\n        n_jobs=-1\n    )\n\n    model.fit(X_tr, y_tr)\n    probs = model.predict_proba(X_te)[:, 1]\n\n    return roc_auc_score(y_te, probs)\n\n# Use 24h early-window matrices for Figure 5 (paper-comparable; avoids inflated all-admission AUROC)\nprint(\"Loading eICU 24h matrix for Figure 5...\")\neicu_24h_path = OUT_DIR / \"data_matrix_eicu_24h.csv\"\nif eicu_24h_path.exists():\n    dm_eicu_24h = pd.read_csv(eicu_24h_path)\n    print(\"Loaded eICU 24h matrix:\", dm_eicu_24h.shape)\nelse:\n    print(\"WARNING: eICU 24h matrix not found. Falling back to full eICU matrix.\")\n    dm_eicu_24h = dm_eicu.copy()\n\n# QC clip the 24h eICU matrix\ndm_eicu_24h_qc = qc_clip_features(dm_eicu_24h.copy(), META_COLS)\n\n# Run EHR-ML on 24h eICU for internally consistent Figure 5 diagonal\nif \"eicu_mort_24h\" not in globals():\n    print(\"Running EHR-ML on eICU 24h QC matrix for Figure 5...\")\n    eicu_mort_24h = run_ehrml(\n        dm_eicu_24h_qc,\n        target_col=\"mortality\",\n        tag=\"[eICU ICD 24h QC]\"\n    )\nelse:\n    print(\"Using existing eicu_mort_24h result.\")\n\nmimic_fig5_dm = standardise_cols(dm_icd_24h_hosp_qc.copy(), META_COLS)\neicu_fig5_dm  = standardise_cols(dm_eicu_24h_qc.copy(), META_COLS)\n\nmimic_auc = get_auc_from_result(icd_mort_paper)\neicu_auc  = get_auc_from_result(eicu_mort_24h)\n\nmimic2eicu = cross_auroc(mimic_fig5_dm, eicu_fig5_dm)\neicu2mimic = cross_auroc(eicu_fig5_dm, mimic_fig5_dm)\n\nhm = np.array([\n    [mimic_auc, mimic2eicu],\n    [eicu2mimic, eicu_auc]\n])\n\nlbs = [\"MIMIC-IV ICD\", \"eICU ICD\"]\n\nprint(\n    f\"MIMIC->MIMIC={mimic_auc:.3f}  \"\n    f\"eICU->eICU={eicu_auc:.3f}  \"\n    f\"MIMIC->eICU={mimic2eicu:.3f}  \"\n    f\"eICU->MIMIC={eicu2mimic:.3f}\"\n)\n\nfig, ax = plt.subplots(figsize=(5, 4))\nim = ax.imshow(hm, cmap=\"Blues\", vmin=0.5, vmax=1.0, aspect=\"auto\")\nplt.colorbar(im, ax=ax, label=\"AUROC\")\n\nax.set_xticks([0, 1])\nax.set_xticklabels(lbs, rotation=15, ha=\"right\")\nax.set_yticks([0, 1])\nax.set_yticklabels(lbs)\n\nax.set_xlabel(\"Validation Set\")\nax.set_ylabel(\"Training Set\")\nax.set_title(\"Figure 5: MIMIC-IV ↔ eICU Inter-Source Validation\", fontweight=\"bold\")\n\nfor i in range(2):\n    for j in range(2):\n        v = hm[i, j]\n        ax.text(\n            j, i,\n            f\"{v:.3f}\" if not np.isnan(v) else \"N/A\",\n            ha=\"center\",\n            va=\"center\",\n            fontsize=13,\n            fontweight=\"bold\",\n            color=\"white\" if v > 0.75 else \"black\"\n        )\n\nplt.tight_layout()\nplt.savefig(OUT_DIR / \"fig5_intercohort_eicu.png\", bbox_inches=\"tight\", dpi=150)\nplt.show()\n\nprint(\"Paper: MIMIC->MIMIC=0.85  eICU->eICU=0.89  MIMIC->eICU=0.84  eICU->MIMIC=0.83\")\nprint(\"Saved:\", OUT_DIR / \"fig5_intercohort_eicu.png\")\n","metadata":{"execution":{"iopub.execute_input":"2026-06-23T09:11:12.188797Z","iopub.status.busy":"2026-06-23T09:11:12.188181Z","iopub.status.idle":"2026-06-23T09:11:12.61072Z","shell.execute_reply":"2026-06-23T09:11:12.609775Z"},"papermill":{"duration":0.445417,"end_time":"2026-06-23T09:11:12.612491+00:00","exception":false,"start_time":"2026-06-23T09:11:12.167074+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Using existing eicu_mort result.\n","Common features: 0\n","First common features: []\n","Common features: 0\n","First common features: []\n","MIMIC->MIMIC=0.983  eICU->eICU=0.935  MIMIC->eICU=nan  eICU->MIMIC=nan\n"]},{"data":{"image/png":"\n","text/plain":["<Figure size 600x480 with 2 Axes>"]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["Paper: MIMIC->MIMIC=0.85  eICU->eICU=0.89  MIMIC->eICU=0.84  eICU->MIMIC=0.83\n","Saved: /kaggle/working/ehr_ml_output/fig5_intercohort_eicu.png\n"]}],"execution_count":19},{"id":"9fc85ae4","cell_type":"markdown","source":"## 🕒 Step 11 — Figure 6A: Data Window Analysis (WB × WA Heatmap)","metadata":{"papermill":{"duration":0.01731,"end_time":"2026-06-23T09:11:12.648033+00:00","exception":false,"start_time":"2026-06-23T09:11:12.630723+00:00","status":"completed"},"tags":[]}},{"id":"f9a02f21","cell_type":"code","source":"# Prepare per-measurement data for window filtering\nprint('Preparing per-measurement data...')\nids_icd   = icd_cohort['hadm_id'].unique()\ncohort_t  = icd_cohort[['hadm_id','intime','mortality']].copy()\ncohort_t['intime'] = pd.to_datetime(cohort_t['intime'])\n\nce_w = chartevents[chartevents['hadm_id'].isin(ids_icd) & chartevents['itemid'].isin(VITALS)].copy()\nce_w['charttime'] = pd.to_datetime(ce_w['charttime'])\nce_w['feature']   = ce_w['itemid'].map(VITALS)\nce_w = ce_w[ce_w['valuenum'].notna()].merge(cohort_t, on='hadm_id', how='inner')\nce_w['dfa'] = (ce_w['charttime'] - ce_w['intime']).dt.total_seconds()/86400\n\nle_w = labevents[labevents['hadm_id'].isin(ids_icd) & labevents['itemid'].isin(LABS)].copy()\nle_w['charttime'] = pd.to_datetime(le_w['charttime'])\nle_w['feature']   = le_w['itemid'].map(LABS)\nle_w = le_w[le_w['valuenum'].notna()].merge(cohort_t, on='hadm_id', how='inner')\nle_w['dfa'] = (le_w['charttime'] - le_w['intime']).dt.total_seconds()/86400\n\ndef build_window(ce, le, wb, wa):\n    cf = ce[(ce['dfa']>=-wb) & (ce['dfa']<=wa)]\n    lf = le[(le['dfa']>=-wb) & (le['dfa']<=wa)]\n    parts = []\n    for df2, prefix in [(cf,'vitals'),(lf,'labs')]:\n        if len(df2)<1: continue\n        for fn in ['mean','min','max']:\n            g = df2.groupby(['hadm_id','feature'])['valuenum'].agg(fn).reset_index()\n            p = g.pivot_table(index='hadm_id',columns='feature',values='valuenum').reset_index()\n            p.columns=[c if c=='hadm_id' else f'{prefix}_{c}_{fn}' for c in p.columns]\n            parts.append(p)\n    if not parts: return pd.DataFrame()\n    r = parts[0]\n    for p in parts[1:]: r=r.merge(p,on='hadm_id',how='outer')\n    return r.merge(cohort_t[['hadm_id','mortality']].drop_duplicates(),on='hadm_id',how='inner')\n\ndef quick_auc(df, target='mortality'):\n    if len(df)<20: return np.nan\n    y = df[target].values\n    if y.sum()<3 or (len(y)-y.sum())<3: return np.nan\n    X = impute(df[[c for c in df.columns if c not in ['hadm_id',target]]]).values\n    try:\n        xgb = XGBClassifier(eval_metric='logloss',verbosity=0,n_estimators=50)\n        cv  = cross_validate(xgb,X,y,cv=5,scoring='roc_auc')\n        return cv['test_score'].mean()\n    except: return np.nan\n\nWB = [0,1,2,3]; WA = [1,2,3,5,7,10,14]\ngrid = np.full((len(WB),len(WA)),np.nan)\n\nprint('Running window analysis...')\nfor i,wb in enumerate(WB):\n    for j,wa in enumerate(WA):\n        dm_w = build_window(ce_w, le_w, wb, wa)\n        if len(dm_w)>0:\n            a = quick_auc(dm_w)\n            grid[i,j]=a\n            print(f'  WB={wb} WA={wa}: AUROC={a:.3f} (n={len(dm_w)})')\n\nprint('✅ Window analysis done!')\n","metadata":{"execution":{"iopub.execute_input":"2026-06-23T09:11:12.683522Z","iopub.status.busy":"2026-06-23T09:11:12.683116Z","iopub.status.idle":"2026-06-23T09:12:09.923914Z","shell.execute_reply":"2026-06-23T09:12:09.923309Z"},"papermill":{"duration":57.263294,"end_time":"2026-06-23T09:12:09.928256+00:00","exception":false,"start_time":"2026-06-23T09:11:12.664962+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Preparing per-measurement data...\n","Running window analysis...\n","  WB=0 WA=1: AUROC=0.826 (n=2860)\n","  WB=0 WA=2: AUROC=0.857 (n=2860)\n","  WB=0 WA=3: AUROC=0.877 (n=2860)\n","  WB=0 WA=5: AUROC=0.906 (n=2860)\n","  WB=0 WA=7: AUROC=0.918 (n=2860)\n","  WB=0 WA=10: AUROC=0.931 (n=2860)\n","  WB=0 WA=14: AUROC=0.940 (n=2860)\n","  WB=1 WA=1: AUROC=0.824 (n=2860)\n","  WB=1 WA=2: AUROC=0.860 (n=2860)\n","  WB=1 WA=3: AUROC=0.873 (n=2860)\n","  WB=1 WA=5: AUROC=0.901 (n=2860)\n","  WB=1 WA=7: AUROC=0.918 (n=2860)\n","  WB=1 WA=10: AUROC=0.931 (n=2860)\n","  WB=1 WA=14: AUROC=0.937 (n=2860)\n","  WB=2 WA=1: AUROC=0.830 (n=28