-dir/eicu-collaborative-research-database-2.0')\n\n# ── Smart loader: handles both direct files AND nested folder/file.csv ────────\ndef load_eicu(fname, **kw):\n    \"\"\"Try direct path first, then nested path (Kaggle large-file quirk).\"\"\"\n    candidates = [\n        EICU_DIR / fname,                    # direct: diagnosis.csv\n        EICU_DIR / fname / fname,            # nested: vitalPeriodic.csv/vitalPeriodic.csv\n        EICU_DIR / (fname + '.gz'),\n        EICU_DIR / fname / (fname + '.gz'),\n    ]\n    for fp in candidates:\n        if fp.exists() and fp.is_file():\n            print(f'    Loading: {fp}')\n            return pd.read_csv(fp, low_memory=False, **kw)\n    raise FileNotFoundError(f'Could not find: {fname} in {EICU_DIR}')\n\n# ── Build eICU Sepsis cohort ──────────────────────────────────────────────────\nprint('Building eICU Sepsis cohort...')\neicu_diag = load_eicu('diagnosis.csv', usecols=['patientunitstayid','icd9code']).dropna()\neicu_pat  = load_eicu('patient.csv',   usecols=['patientunitstayid','uniquepid','age',\n                                                  'unitdischargeoffset','hospitaldischargestatus'])\n\ndef clean_age(a):\n    if pd.isna(a) or str(a).strip() == '': return 0\n    s = str(a).strip()\n    if s.startswith('>'): return 90\n    try: return float(s)\n    except: return 0\n\neicu_pat['age_num'] = eicu_pat['age'].apply(clean_age)\neicu_pat_adults = eicu_pat[eicu_pat['age_num'] >= 18]\n\nsepsis_codes = {'995.91', '995.92', '785.52'}\ndef has_sepsis(val):\n    return any(c.strip() in sepsis_codes for c in str(val).split(','))\n\neicu_diag_sepsis = eicu_diag[eicu_diag['icd9code'].apply(has_sepsis)]\neicu_cohort = eicu_diag_sepsis.merge(eicu_pat_adults, on='patientunitstayid', how='inner')\neicu_cohort = eicu_cohort.drop_duplicates(subset=['patientunitstayid'])\nprint(f'  eICU Sepsis cohort: {eicu_cohort.shape[0]} episodes')\neicu_stay_ids = set(eicu_cohort['patientunitstayid'])\n\nEICU_VITAL_COLS = {\n    'temperature':'temperature_f', 'sao2':'spo2', 'heartrate':'heart_rate',\n    'respiration':'resp_rate', 'systemicsystolic':'sbp',\n    'systemicdiastolic':'dbp', 'systemicmean':'mbp'\n}\nEICU_LAB_NAMES = {\n    'Hct':'hematocrit','Hgb':'hemoglobin','platelets x 1000':'platelet',\n    'WBC x 1000':'wbc','creatinine':'creatinine','potassium':'potassium',\n    'sodium':'sodium','calcium':'calcium','bicarbonate':'bicarbonate',\n    'lactate':'lactate','anion gap':'anion_gap','BUN':'bun',\n    'glucose':'glucose','magnesium':'magnesium','phosphate':'phosphate',\n    'PT - INR':'inr','PTT':'ptt','ALT (SGPT)':'alt','AST (SGOT)':'ast',\n    'total bilirubin':'bilirubin_total','pH':'ph','paCO2':'pco2','paO2':'po2'\n}\n\n# ── Load vitalPeriodic (nested path) ─────────────────────────────────────────\nprint('  Processing vitalPeriodic...')\nvital_usecols = ['patientunitstayid','observationoffset'] + list(EICU_VITAL_COLS.keys())\nvp_path = EICU_DIR / 'vitalPeriodic.csv' / 'vitalPeriodic.csv'  # nested!\nv_chunks = []\nfor chunk in pd.read_csv(vp_path, usecols=vital_usecols, chunksize=500000, low_memory=False):\n    f = chunk[chunk['patientunitstayid'].isin(eicu_stay_ids) &\n              (chunk['observationoffset'] >= 0) &\n              (chunk['observationoffset'] <= 4320)]\n    if not f.empty: v_chunks.append(f)\neicu_v = pd.concat(v_chunks, ignore_index=True) if v_chunks else pd.DataFrame()\ndel v_chunks; gc.collect()\nif not eicu_v.empty and 'temperature' in eicu_v.columns:\n    eicu_v['temperature'] = eicu_v['temperature'] * 9/5 + 32\nif not eicu_v.empty:\n    eicu_v = eicu_v.rename(columns=EICU_VITAL_COLS)\nprint(f'    vitals shape: {eicu_v.shape}')\n\n# ── Load lab (find correct path) ──────────────────────────────────────────────\nprint('  Processing lab...')\n# Check both possible paths\nlab_path = EICU_DIR / 'lab.csv' / 'lab.csv'\nif not lab_path.exists(): lab_path = EICU_DIR / 'lab.csv'\nprint(f'    lab path: {lab_path}  exists={lab_path.exists()}')\nl_chunks = []\nfor chunk in p