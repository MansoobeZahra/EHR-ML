    "        iso = IsolationForest(contamination=0.05, random_state=42)\n",
    "        mask = iso.fit_predict(XTr) == 1\n",
    "        if len(np.unique(yTr[mask])) > 1:\n",
    "            XTr, yTr = XTr[mask], yTr[mask]\n",
