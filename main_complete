    "def run_ehrml(dm, target_col='mortality', test_size=0.5, seed=42, tag=''):\n",
    "    log.info(f'=== EHR-ML | target={target_col} {tag} ===')\n",
    "\n",
    "    feat_cols = [c for c in dm.columns if c not in META_COLS]\n",
    "    subsets   = get_subsets(dm)\n",
    "    X_full    = impute(dm[feat_cols]).dropna(axis=1, how='all')\n",
    "    y         = dm[target_col].values.ravel()\n",
    "\n",
    "    log.info(f'n={len(y)}, features={X_full.shape[1]}, pos_rate={y.mean():.2%}')\n",
    "\n",
    "    idx    = np.arange(len(y))\n",
    "    tr_i, te_i = train_test_split(idx, test_size=test_size, random_state=seed, stratify=y)\n",
    "    XTr, XTe   = X_full.iloc[tr_i].values, X_full.iloc[te_i].values\n",
    "    yTr, yTe   = y[tr_i], y[te_i]\n",
    "\n",
    "    sub_sp = {}\n",
    "    for k, v in subsets.items():\n",
    "        v2 = impute(v).dropna(axis=1, how='all')\n",
    "        sub_sp[k] = (v2.iloc[tr_i].values, v2.iloc[te_i].values)\n",
    "\n",
    "    # Hyperparameter tuning\n",
    "    ref = sub_sp.get('vitals_avg', list(sub_sp.values())[0])\n",
    "    log.info('Tuning XGB (sub)...'); xp   = tune_xgb(ref[0], yTr)\n",
    "    log.info('Tuning LR (sub)...');  lp   = tune_lr(ref[0],  yTr)\n",
    "    log.info('Tuning XGB (full)...'); xp_f = tune_xgb(XTr, yTr)\n",
    "    log.info('Tuning LR (full)...');  lp_f = tune_lr(XTr,  yTr)\n",
    "\n",
    "    # Level-1: 4 models x (10 + 1 Full) feature sets\n",
    "    feature_sets = {'Full': (XTr, XTe, xp_f, lp_f)}\n",
    "    feature_sets.update({k: (v[0], v[1], xp, lp) for k, v in sub_sp.items()})\n",
    "\n",
    "    probs_dict = {}\n",
    "    log.info('Building Level-1 models...')\n",
    "    for lbl, (tr, te, pxgb, plr) in feature_sets.items():\n",
    "        if tr.shape[1] == 0: continue\n",
    "        log.info(f'  {lbl} ({tr.shape[1]} features)')\n",
    "\n",
    "        m = XGBClassifier(eval_metric='logloss', verbosity=0, **pxgb); m.fit(tr, yTr)\n",
    "        probs_dict[('XGB',  lbl)] = m.predict_proba(te)[:,1]\n",
    "\n",
    "        m = LogisticRegression(max_iter=1000, **plr); m.fit(tr, yTr)\n",
    "        probs_dict[('LR',   lbl)] = m.predict_proba(te)[:,1]\n",
    "\n",
    "        m = LGBMClassifier(verbose=-1, **pxgb); m.fit(tr, yTr)\n",
    "        probs_dict[('LGBM', lbl)] = m.predict_proba(te)[:,1]\n",
    "\n",
    "        hs = (tr.shape[1]*2, tr.shape[1]*2)\n",
    "        m  = MLPClassifier(random_state=1, max_iter=300, hidden_layer_sizes=hs); m.fit(tr, yTr)\n",
    "        probs_dict[('MLP',  lbl)] = m.predict_proba(te)[:,1]\n",
    "\n",
    "    # Level-2: XGBoost meta-learner (5-fold CV, paper Section 2.3)\n",
    "    log.info('Building Level-2 meta-learner (5-fold CV)...')\n",
    "    Xmeta = pd.DataFrame({f'{m}_{l}': v for (m,l), v in probs_dict.items()})\n",
    "    meta  = XGBClassifier(eval_metric='logloss', verbosity=0)\n",
    "    cv_sc = cross_validate(meta, Xmeta, yTe, cv=5, scoring=SCORING)\n",
    "    meta.fit(Xmeta, yTe)\n",
    "    final_probs = meta.predict_proba(Xmeta)[:,1]\n",
    "\n",
    "    print(f'\\n📊 Results | {target_col} {tag}')\n",
    "    print('-'*55)\n",
    "    for k,v in cv_sc.items():\n",
    "        if k.startswith('test_'):\n",
    "            print(f'  {k.replace(\"test_\",\"\"):22}: {v.mean():.4f} ± {v.std():.4f}')\n",
    "\n",
    "    return dict(cv_scores=cv_sc, y_test=yTe, final_probs=final_probs,\n",
    "                Xmeta=Xmeta, probs_dict=probs_dict, meta=meta,\n",
    "                XTr=XTr, XTe=XTe, yTr=yTr)\n",
    "\n",
    "print('✅ run_ehrml() ready!')\n"
   ]
