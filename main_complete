    "from sklearn.model_selection import train_test_split\n",
    "from sklearn.metrics import roc_auc_score, confusion_matrix, ConfusionMatrixDisplay\n",
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "print(\"=\" * 55)\n",
    "print(\"   PREDICTIONS vs ACTUAL VALUES\")\n",
    "print(\"  Using MIMIC-IV ICD Cohort — Mortality Target\")\n",
    "print(\"=\" * 55)\n",
    "\n",
    "# ── Train/test split and predict ──────────────────────────────────────────────\n",
    "feat_cols = [c for c in dm_icd.columns if c not in META_COLS]\n",
    "X = impute(dm_icd[feat_cols]).values\n",
    "y = dm_icd['mortality'].values\n",
    "\n",
    "X_train, X_test, y_train, y_test = train_test_split(\n",
    "    X, y, test_size=0.20, random_state=42, stratify=y)\n",
    "\n",
    "model = XGBClassifier(n_estimators=100, verbosity=0, eval_metric='logloss', random_state=42)\n",
    "model.fit(X_train, y_train)\n",
    "\n",
    "y_prob = model.predict_proba(X_test)[:, 1]\n",
    "y_pred = (y_prob >= 0.5).astype(int)\n",
    "auroc  = roc_auc_score(y_test, y_prob)\n",
    "\n",
    "# ── Sample prediction table ───────────────────────────────────────────────────\n",
    "sample_df = pd.DataFrame({\n",
    "    'Actual':          y_test[:20],\n",
    "    'Predicted Label': y_pred[:20],\n",
    "    'Death Probability': [f\"{p:.3f}\" for p in y_prob[:20]],\n",
    "    'Correct?':        ['✅' if a == p else '❌' for a,p in zip(y_test[:20], y_pred[:20])]\n",
    "})\n",
    "print(f\"\\nTest set AUROC: {auroc:.4f}  |  Test size: {len(y_test)} patients\")\n",
    "print(f\"\\nFirst 20 predictions:\\n\")\n",
    "print(sample_df.to_string(index=False))\n",
    "\n",
    "# ── Visual: Confusion Matrix + Probability Distribution ──────────────────────\n",
    "fig, axes = plt.subplots(1, 2, figsize=(12, 5))\n",
    "fig.patch.set_facecolor('#0d1117')\n",
    "\n",
    "# Confusion matrix\n",
    "cm = confusion_matrix(y_test, y_pred)\n",
    "disp = ConfusionMatrixDisplay(cm, display_labels=['Survived', 'Died'])\n",
    "disp.plot(ax=axes[0], colorbar=False, cmap='Blues')\n",
    "axes[0].set_title('Confusion Matrix\\n(Predicted vs Actual)', color='white', fontweight='bold')\n",
    "axes[0].set_facecolor('#161b22')\n",
    "axes[0].tick_params(colors='white')\n",
    "axes[0].xaxis.label.set_color('white')\n",
    "axes[0].yaxis.label.set_color('white')\n",
    "\n",
    "# Probability distribution\n",
    "axes[1].set_facecolor('#161b22')\n",
    "survived = y_prob[y_test == 0]\n",
    "died     = y_prob[y_test == 1]\n",
    "axes[1].hist(survived, bins=30, alpha=0.7, color='#00d4aa', label='Actually Survived')\n",
    "axes[1].hist(died,     bins=30, alpha=0.7, color='#ff6b6b', label='Actually Died')\n",
    "axes[1].axvline(0.5, color='white', linestyle='--', alpha=0.8, label='Decision threshold (0.5)')\n",
    "axes[1].set_xlabel('Predicted Death Probability', color='white')\n",
    "axes[1].set_ylabel('Number of Patients', color='white')\n",
    "axes[1].set_title(f'Predicted Probability Distribution\\nAUROC = {auroc:.4f}',\n",
    "                  color='white', fontweight='bold')\n",
    "axes[1].tick_params(colors='white')\n",
    "axes[1].legend(facecolor='#161b22', labelcolor='white')\n",
    "axes[1].spines[:].set_color('#444')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig(OUT_DIR / 'predictions_vs_actual.png', bbox_inches='tight', dpi=150, facecolor='#0d1117')\n",
    "plt.show()\n",
    "\n",
    "# ── Summary stats ─────────────────────────────────────────────────────────────\n",
    "tn, fp, fn, tp = cm.ravel()\n",
    "print(f\"\\n📊 Test Set Summary ({len(y_test)} patients):\")\n",
    "print(f\"   True Positives  (correctly predicted death)    : {tp}\")\n",
    "print(f\"   True Negatives  (correctly predicted survival) : {tn}\")\n",
    "print(f\"   False Positives (predicted death, actually survived): {fp}\")\n",
    "print(f\"   False Negatives (predicted survival, actually died) : {fn}\")\n",
    "print(f\"   Sensitivity (Recall): {tp/(tp+fn):.3f}\")\n",
    "print(f\"   Specificity:          {tn/(tn+fp):.3f}\")\n",
    "print(f\"   AUROC:                {auroc:.4f}\")\n",
    "print(f\"\\n✅ Predictions saved to: {OUT_DIR}/predictions_vs_actual.png\")"
   ]
