    "                # LGBM\n",
    "                m = LGBMClassifier(verbose=-1, **xp)\n",
    "                m.fit(X_it, y_it)\n",
    "                Xmeta.loc[iv_idx, f'LGBM_{sn}'] = m.predict_proba(X_iv)[:, 1]\n",
