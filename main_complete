    "        print(f'    Significant differences found:')\n",
    "        for f in sig_findings:\n",
    "            print(f'      {f}')\n",
    "    else:\n",
    "        print(f'    No significant differences (all p >= 0.05).')\n",
    "        print(f'    -> Preprocessing strategy has minimal impact on AUROC for this pipeline.')\n"
