    "                # LR\n",
    "                m = LogisticRegression(max_iter=1000, **lp)\n",
    "                m.fit(X_it, y_it)\n",
    "                Xmeta.loc[iv_idx, f'LR_{sn}'] = m.predict_proba(X_iv)[:, 1]\n",
