1","cell_type":"code","source":"def agg_wide(df, id_cols, feat_col, val_col, prefix):\n    # Long -> wide with 5 aggregations: avg, min, max, first, last.\n    df = df.copy()\n    parts = []\n    df_s = df.sort_values(id_cols + ['charttime'])\n    for agg_name, fn in [('avg','mean'),('min','min'),('max','max'),\n                          ('first','first'),('last','last')]:\n        if agg_name in ('first','last'):\n            g = df_s.groupby(id_cols + [feat_col])[val_col].agg(fn).reset_index()\n        else:\n            g = df.groupby(id_cols + [feat_col])[val_col].agg(fn).reset_index()\n        piv = g.pivot_table(index=id_cols, columns=feat_col, values=val_col).reset_index()\n        piv.columns = [c if c in id_cols else f'{prefix}_{c}_{agg_name}' for c in piv.columns]\n        parts.append(piv)\n    result = parts[0]\n    for p in parts[1:]:\n        result = result.merge(p, on=id_cols, how='outer')\n    return result\n\n\ndef build_dm(cohort_df, cov_thresh=0.80, label=''):\n    # Build EHR-ML data matrix with coverage filtering.\n    print(f'\\nBuilding data matrix [{label}] ({cohort_df.shape[0]} episodes, cov≥{cov_thresh:.0%})...')\n    ids = cohort_df['hadm_id'].unique()\n    id_cols = ['subject_id','hadm_id']\n\n    ce = chartevents[chartevents['hadm_id'].isin(ids) & chartevents['itemid'].isin(VITALS)].copy()\n    ce['feature']   = ce['itemid'].map(VITALS)\n    ce['charttime'] = pd.to_datetime(ce['charttime'])\n    ce = ce[ce['valuenum'].notna() & (ce['valuenum'] > 0)]\n    vw = agg_wide(ce, id_cols, 'feature', 'valuenum', 'vitals') if len(ce) else pd.DataFrame()\n\n    le = labevents[labevents['hadm_id'].isin(ids) & labevents['itemid'].isin(LABS)].copy()\n    le['feature']   = le['itemid'].map(LABS)\n    le['charttime'] = pd.to_datetime(le['charttime'])\n    le = le[le['valuenum'].notna() & (le['valuenum'] >= 0)]\n    lw = agg_wide(le, id_cols, 'feature', 'valuenum', 'labs') if len(le) else pd.DataFrame()\n\n    if not vw.empty and not lw.empty:\n        feats = vw.merge(lw, on=id_cols, how='outer')\n    elif not vw.empty:\n        feats = vw\n    else:\n        feats = lw\n\n    META = ['subject_id','hadm_id','anchor_date','mortality','los_gt7','los_gt14','cohort']\n    dm = cohort_df[META].merge(feats, on=id_cols, how='left')\n\n    feat_cols = [c for c in dm.columns if c not in META]\n    coverage  = dm[feat_cols].notna().mean()\n    keep      = coverage[coverage >= cov_thresh].index.tolist()\n\n    print(f'  Total features        : {len(feat_cols)}')\n    print(f'  After cov ≥{cov_thresh:.0%}     : {len(keep)}')\n\n    dm = dm[META + keep].dropna(subset=keep, how='all')\n    print(f'  Final shape           : {dm.shape}')\n    print(f'  Mortality rate        : {dm[\"mortality\"].mean():.1%}')\n    return dm\n\n# Build both cohort matrices (paper: 80% coverage)\ndm_icd   = build_dm(icd_cohort,   cov_thresh=0.80, label='ICD')\ndm_micro = build_dm(micro_cohort, cov_thresh=0.80, label='Micro')\n\ndm_icd.to_csv(OUT_DIR / 'data_matrix_icd.csv',   index=False)\ndm_micro.to_csv(OUT_DIR / 'data_matrix_micro.csv', index=False)\n\n# ─── Extract eICU ICD Cohort and build data matrix ───────────────────────────\nif EICU_DIR.exists():\n    print('\\nBuilding eICU Sepsis cohort...')\n    try:\n        eicu_diag = load(EICU_DIR / 'diagnosis.csv', usecols=['patientunitstayid', 'icd9code']).dropna()\n        eicu_pat  = load(EICU_DIR / 'patient.csv', usecols=['patientunitstayid', 'uniquepid', 'age', 'unitdischargeoffset', 'hospitaldischargestatus'])\n        \n        def clean_age(a):\n            if pd.isna(a) or str(a).strip() == '': return 0\n            a_str = str(a).strip()\n            if a_str.startswith('>'): return 90\n            try: return float(a_str)\n            except: return 0\n\n        eicu_pat['age_numeric'] = eicu_pat['age'].apply(clean_age)\n        eicu_pat_adults = eicu_pat[eicu_pat['age_numeric'] >= 18]\n\n        sepsis_codes = {'995.91', '995.92', '785.52'}\n        def has_sepsis(val):\n            codes = [c.strip() for c in val.split(',')]\n            return any(c in sepsis_codes for c in codes)\n        \n        eicu_diag_sepsis = eicu_diag[eicu_diag['icd9code'].apply(has_sepsis)]\n        eicu_cohort = eicu_diag_sepsis.merge(eicu_pat_adults, on='patientunitstayid', how='inner')\n        eicu_cohort = eicu_cohort.drop_duplicates(subset=['patientunitstayid'])\n        print(f'  eICU Sepsis cohort size: {eicu_cohort.shape[0]} episodes')\n\n        eicu_stay_ids = set(eicu_cohort['patientunitstayid'])\n\n        EICU_VITAL_COLS = {\n            'temperature': 'temperature_f',\n            'sao2': 'spo2',\n            'heartrate': 'heart_rate',\n            'respiration': 'resp_rate',\n            'systemicsystolic': 'sbp',\n            'systemicdiastolic': 'dbp',\n            'systemicmean': 'mbp'\n        }\n\n        EICU_LAB_NAMES = {\n            'Hct': 'hematocrit', 'Hgb': 'hemoglobin', 'platelets x 1000': 'platelet',\n            'WBC x 1000': 'wbc', 'creatinine': 'creatinine', 'potassium': 'potassium',\n            'sodium': 'sodium', 'calcium': 'calcium', 'bicarbonate': 'bicarbonate',\n            'lactate': 'lactate', 'anion gap': 'anion_gap', 'BUN': 'bun',\n            'glucose': 'glucose', 'magnesium': 'magnesium', 'phosphate': 'phosphate',\n            'PT - INR': 'inr', 'PTT': 'ptt', 'ALT (SGPT)': 'alt', 'AST (SGOT)': 'ast',\n            'total bilirubin': 'bilirubin_total', 'pH': 'ph', 'paCO2': 'pco2', 'paO2': 'po2'\n        }\n\n        print('  Processing eICU vitalPeriodic in chunks...')\n        eicu_v_chunks = []\n        for chunk in pd.read_csv(EICU_DIR / 'vitalPeriodic.csv.gz' if (EICU_DIR / 'vitalPeriodic.csv.gz').exists() else EICU_DIR / 'vitalPeriodic.csv',\n                                 usecols=['patientunitstayid', 'observationoffset'] + list(EICU_VITAL_COLS.keys()),\n                                 chunksize=1000000):\n            filtered = chunk[chunk['patientunitstayid'].isin(eicu_stay_ids) & \n                             (chunk['observationoffset'] >= 0) & \n                             (chunk['observationoffset'] <= 4320)]\n            if not filtered.empty: eicu_v_chunks.append(filtered)\n\n        eicu_v_df = pd.concat(eicu_v_chunks) if eicu_v_chunks else pd.DataFrame()\n\n        if not eicu_v_df.empty and 'temperature' in eicu_v_df.columns:\n            eicu_v_df['temperature'] = eicu_v_df['temperature'] * 9/5 + 32\n        if not eicu_v_df.empty:\n            eicu_v_df = eicu_v_df.rename(columns=EICU_VITAL_COLS)\n\n        print('  Processing eICU lab in chunks...')\n        eicu_l_chunks = []\n        for chunk in pd.read_csv(EICU_DIR / 'lab.csv.gz' if (EICU_DIR / 'lab.csv.gz').exists() else EICU_DIR / 'lab.csv',\n                                 usecols=['patientunitstayid', 'labresultoffset', 'labname', 'labresult'],\n                                 chunksize=1000000):\n            filtered = chunk[chunk['patientunitstayid'].isin(eicu_stay_ids) &\n                             (chunk['labname'].isin(EICU_LAB_NAMES.keys())) &\n                             (chunk['labresultoffset'] >= 0) &\n                             (chunk['labresultoffset'] <= 4320)]\n            if not filtered.empty: eicu_l_chunks.append(filtered)\n\n        eicu_l_df = pd.concat(eicu_l_chunks) if eicu_l_chunks else pd.DataFrame()\n\n        if not eicu_l_df.empty:\n            eicu_l_df['feature'] = eicu_l_df['labname'].map(EICU_LAB_NAMES)\n            eicu_l_df = eicu_l_df.dropna(subset=['feature'])\n\n        print('  Aggregating eICU features...')\n        eicu_wide_v = pd.DataFrame()\n        if not eicu_v_df.empty:\n            v_long = eicu_v_df.melt(id_vars=['patientunitstayid', 'observationoffset'], \n                                   value_vars=[c for c in eicu_v_df.columns if c not in ['patientunitstayid', 'observationoffset']],\n                                   var_name='feature', value_name='valuenum').dropna()\n            eicu_wide_v = agg_wide(v_long, ['patientunitstayid'], 'observationoffset', 'feature', 'valuenum', 'vitals')\n\n        eicu_wide_l = pd.DataFrame()\n        if not eicu_l_df.empty:\n            eicu_wide_l = agg_wide(eicu_l_df, ['patientunitstayid'], 'labresultoffset', 'feature', 'labresult', 'labs')\n\n        # Demographics & Labels\n        eicu_cohort['mortality'] = (eicu_cohort['hospitaldischargestatus'] == 'Expired').astype(int)\n        eicu_cohort['los'] = eicu_cohort['unitdischargeoffset'] / 1440.0\n        eicu_cohort['los_gt7'] = (eicu_cohort['los'] > 7).astype(int)\n        eicu_cohort['los_gt14'] = (eicu_cohort['los'] > 14).astype(int)\n        eicu_cohort['cohort'] = 'eICU'\n        eicu_cohort['anchor_date'] = '2000-01-01'\n\n        eicu_meta = ['patientunitstayid', 'uniquepid', 'anchor_date', 'mortality', 'los_gt7', 'los_gt14', 'cohort']\n        dm_eicu = eicu_cohort[eicu_meta]\n\n        if not eicu_wide_v.empty:\n            dm_eicu = dm_eicu.merge(eicu_wide_v, on='patientunitstayid', how='left')\n        if not eicu_wide_l.empty:\n            dm_eicu = dm_eicu.merge(eicu_wide_l, on='patientunitstayid', how='left')\n\n        dm_eicu = dm_eicu.rename(columns={'patientunitstayid': 'hadm_id', 'uniquepid': 'subject_id'})\n        \n        eicu_feat_cols = [c for c in dm_eicu.columns if c not in META_COLS]\n        eicu_coverage = dm_eicu[eicu_feat_cols].notna().mean()\n        eicu_keep = eicu_coverage[eicu_coverage >= 0.80].index.tolist()\n        dm_eicu = dm_eicu[META_COLS + eicu_keep].dropna(subset=eicu_keep, how='all')\n\n        print(f'  eICU data matrix shape: {dm_eicu.shape}')\n        dm_eicu.to_csv(OUT_DIR / 'data_matrix_eicu.csv', index=False)\n        print('  eICU data matrix saved!')\n    except Exception as e:\n        print(f'  Failed to build eICU data matrix: {e}')\nelse:\n    print('\\nWARNING: EICU_DIR not found. Skipping eICU data matrix extraction.')\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-22T19:38:23.44465Z","iopub.execute_input":"2026-06-22T19:38:23.445391Z","iopub.status.idle":"2026-06-22T19:39:05.127289Z","shell.execute_reply.started":"2026-06-22T19:38:23.445359Z","shell.execute_reply":"2026-06-22T19:39:05.126342Z"}},"outputs":[{"name":"stdout","text":"\nBuilding data matrix [ICD] (13227 episodes, cov≥80%)...\n  Total features        : 170\n  After cov ≥80%     : 155\n  Final shape           : (13227, 162)\n  Mortality rate        : 29.3%\n\nBuilding data matrix [Micro] (4856 episodes, cov≥80%)...\n  Total features        : 170\n  After cov ≥80%     : 155\n  Final shape           : (4856, 162)\n  Mortality rate        : 30.8%\n\nWARNING: EICU_DIR not found. Skipping eICU data matrix extraction.\n","output_type":"stream"}],"execution_count":11},{"id":"343ff6e8-8242-48ac-b258-1da3f268d8a4","cell_type":"markdown","source":"## 🤖 Step 7 — EHR-ML Two-Layer Ensemble\n\n**Figure 1-B:** Level-1 = 4 algorithms × 10 feature subsets = **40 models** -> Level-2 = XGBoost meta-learner","metadata":{}},{"id":"9d0d6031-70e5-4571-98d4-45e40d578638","cell_type":"code","source":"import logging\nfrom sklearn.model_selection import train_test_split, cross_validate, GridSearchCV\nfrom sklearn.linear_model   import LogisticRegression\nfrom sklearn.neural_network import MLPClassifier\nfrom sklearn.metrics        import (\n    roc_auc_score, average_precision_score, matthews_corrcoef,\n    f1_score, accuracy_score, balanced_accuracy_score,\n    roc_curve, precision_recall_curve, confusion_matrix,\n    make_scorer, ConfusionMatrixDisplay\n)\nfrom xgboost  import XGBClassifier\nfrom lightgbm import LGBMClassifier\nimport matplotlib.pyplot as plt\nimport matplotlib.gridspec as gridspec\nimport seaborn as sns\nfrom matplotlib.patches import Patch\n\nplt.rcParams.update({'figure.dpi':120, 'axes.spines.top':False,\n                     'axes.spines.right':False, 'font.size':10})\n\nlogging.basicConfig(level=logging.INFO, format='[EHR-ML] %(message)s')\nlog = logging.getLogger('EHR-ML')\n\nMETA_COLS = ['subject_id','hadm_id','anchor_date','mortality','los_gt7','los_gt14','cohort']\nSCORING = {\n    'accuracy':          'accuracy',\n    'balanced_accuracy': 'balanced_accuracy',\n    'average_precision': 'average_precision',\n    'f1':                'f1',\n    'roc_auc':           'roc_auc',\n    'mcc':               make_scorer(matthews_corrcoef),\n}\n\ndef impute(df):\n    return df.fillna(df.median(numeric_only=True))\n\ndef get_subsets(dm):\n    subsets = {}\n    for prefix in ['vitals','labs']:\n        for agg in ['avg','min','max','first','last']:\n            cols = [c for c in dm.columns if c.startswith(f'{prefix}_') and c.endswith(f'_{agg}')]\n            if cols:\n                subsets[f'{prefix}_{agg}'] = dm[cols].copy()\n    feat_cols = [c for c in dm.columns if c not in META_COLS]\n    subsets['Full'] = dm[feat_cols].copy()\n    return subsets\n\ndef tune_xgb(X, y):\n    p = {}\n    def best(sp):\n        g = GridSearchCV(XGBClassifier(eval_metric='logloss', verbosity=0, **p),\n                         sp, cv=3, n_jobs=-1, verbose=0)\n        g.fit(X, y)\n        return g.cv_results_['params'][list(g.cv_results_['rank_test_score']).index(1)]\n    p.update(best({'max_depth': range(1,7), 'scale_pos_weight':[0.1,0.15,0.2,0.25,0.3,0.35,0.4]}))\n    p.update(best({'n_estimators': range(50,250,10)}))\n    p.update(best({'min_child_weight': range(1,7)}))\n    p.update(best({'gamma': [i/10. for i in range(0,5)]}))\n    p.update(best({'subsample':[i/10. for i in range(1,10)],\n                   'colsample_bytree':[i/10. for i in range(1,10)]}))\n    p.update(best({'reg_alpha':[0,1e-5,1e-3,0.1,10]}))\n    return p\n\ndef tune_lr(X, y):\n    g = GridSearchCV(LogisticRegression(max_iter=1000),\n                     {'solver':['newton-cg','liblinear'],'C':[100,10,1.0,0.1,0.01]},\n                     cv=3, n_jobs=-1)\n    g.fit(X, y)\n    return g.cv_results_['params'][list(g.cv_results_['rank_test_score']).index(1)]\n\nprint('✅ EHR-ML helpers defined!')\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-22T19:39:05.128557Z","iopub.execute_input":"2026-06-22T19:39:05.128921Z","iopub.status.idle":"2026-06-22T19:39:12.315972Z","shell.execute_reply.started":"2026-06-22T19:39:05.128876Z","shell.execute_reply":"2026-06-22T19:39:12.315186Z"}},"outputs":[{"name":"stdout","text":"✅ EHR-ML helpers defined!\n","output_type":"stream"}],"execution_count":12},{"id":"9c629ee7-5b3a-481d-85eb-d43b35fee434","cell_type":"code","source":"def run_ehrml(dm, target_col='mortality', test_size=0.5, seed=42, tag=''):\n    log.info(f'=== EHR-ML | target={target_col} {tag} ===')\n\n    feat_cols = [c for c in dm.columns if c not in META_COLS]\n    subsets   = get_subsets(dm)\n    X_full    = impute(dm[feat_cols]).dropna(axis=1, how='all')\n    y         = dm[target_col].values.ravel()\n\n    log.info(f'n={len(y)}, features={X_full.shape[1]}, pos_rate={y.mean():.2%}')\n\n    idx    = np.arange(len(y))\n    tr_i, te_i = train_test_split(idx, test_size=test_size, random_state=seed, stratify=y)\n    XTr, XTe   = X_full.iloc[tr_i].values, X_full.iloc[te_i].values\n    yTr, yTe   = y[tr_i], y[te_i]\n\n    sub_sp = {}\n    for k, v in subsets.items():\n        v2 = impute(v).dropna(axis=1, how='all')\n        sub_sp[k] = (v2.iloc[tr_i].values, v2.iloc[te_i].values)\n\n    # Hyperparameter tuning\n    ref = sub_sp.get('vitals_avg', list(sub_sp.values())[0])\n    log.info('Tuning XGB (sub)...'); xp   = tune_xgb(ref[0], yTr)\n    log.info('Tuning LR (sub)...');  lp   = tune_lr(ref[0],  yTr)\n    log.info('Tuning XGB (full)...'); xp_f = tune_xgb(XTr, yTr)\n    log.info('Tuning LR (full)...');  lp_f = tune_lr(XTr,  yTr)\n\n    # Level-1: 4 models x (10 + 1 Full) feature sets\n    feature_sets = {'Full': (XTr, XTe, xp_f, lp_f)}\n    feature_sets.update({k: (v[0], v[1], xp, lp) for k, v in sub_sp.items()})\n\n    probs_dict = {}\n    log.info('Building Level-1 models...')\n    for lbl, (tr, te, pxgb, plr) in feature_sets.items():\n        if tr.shape[1] == 0: continue\n        log.info(f'  {lbl} ({tr.shape[1]} features)')\n\n        m = XGBClassifier(eval_metric='logloss', verbosity=0, **pxgb); m.fit(tr, yTr)\n        probs_dict[('XGB',  lbl)] = m.predict_proba(te)[:,1]\n\n        m = LogisticRegression(max_iter=1000, **plr); m.fit(tr, yTr)\n        probs_dict[('LR',   lbl)] = m.predict_proba(te)[:,1]\n\n        m = LGBMClassifier(verbose=-1, **pxgb); m.fit(tr, yTr)\n        probs_dict[('LGBM', lbl)] = m.predict_proba(te)[:,1]\n\n        hs = (tr.shape[1]*2, tr.shape[1]*2)\n        m  = MLPClassifier(random_state=1, max_iter=300, hidden_layer_sizes=hs); m.fit(tr, yTr)\n        probs_dict[('MLP',  lbl)] = m.predict_proba(te)[:,1]\n\n    # Level-2: XGBoost meta-learner (5-fold CV, paper Section 2.3)\n    log.info('Building Level-2 meta-learner (5-fold CV)...')\n    Xmeta = pd.DataFrame({f'{m}_{l}': v for (m,l), v in probs_dict.items()})\n    meta  = XGBClassifier(eval_metric='logloss', verbosity=0)\n    cv_sc = cross_validate(meta, Xmeta, yTe, cv=5, scoring=SCORING)\n    meta.fit(Xmeta, yTe)\n    final_probs = meta.predict_proba(Xmeta)[:,1]\n\n    print(f'\\n📊 Results | {target_col} {tag}')\n    print('-'*55)\n    for k,v in cv_sc.items():\n        if k.startswith('test_'):\n            print(f'  {k.replace(\"test_\",\"\"):22}: {v.mean():.4f} ± {v.std():.4f}')\n\n    return dict(cv_scores=cv_sc, y_test=yTe, final_probs=final_probs,\n                Xmeta=Xmeta, probs_dict=probs_dict, meta=meta,\n                XTr=XTr, XTe=XTe, yTr=yTr)\n\nprint('✅ run_ehrml() ready!')\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-22T19:39:12.317082Z","iopub.execute_input":"2026-06-22T19:39:12.318245Z","iopub.status.idle":"2026-06-22T19:39:12.333102Z","shell.execute_reply.started":"2026-06-22T19:39:12.318204Z","shell.execute_reply":"2026-06-22T19:39:12.332312Z"}},"outputs":[{"name":"stdout","text":"✅ run_ehrml() ready!\n","output_type":"stream"}],"execution_count":13},{"id":"e67c06f6-d130-443c-ae57-defb95e9b164","cell_type":"markdown","sour