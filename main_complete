    "            auc, pval = vals[0], vals[4]\n",
    "            delta = auc - base_auc\n",
    "            if not np.isnan(pval) and pval < 0.05:\n",
    "                sig_findings.append(f'{task_name} / {cond_name}: delta={delta:+.4f} p={pval:.4f}')\n",
